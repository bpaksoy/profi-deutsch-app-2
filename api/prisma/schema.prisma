generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(uuid())
  clerkId                String         @unique
  email                  String         @unique
  name                   String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  stripeCustomerId       String?        @unique
  stripeSubscriptionId   String?        @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  isActive               Boolean        @default(false)
  planTier               String         @default("FREE")
  dailyMessagesCount     Int            @default(0)
  lastMessageAt          DateTime?      @default(now())
  theme                  String         @default("light")
  conversations          Conversation[]
  phrasebook             Phrase[]
  progress               Progress?
}

model Conversation {
  id        String    @id @default(uuid())
  topic     String    @default("Neues Gespräch")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [clerkId])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  timestamp      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Phrase {
  id             String   @id @default(uuid())
  german         String
  english        String?
  context        String?
  category       String   @default("General")
  createdAt      DateTime @default(now())
  userId         String
  conversationId String?
  user           User     @relation(fields: [userId], references: [clerkId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  phraseCount Int      @default(0)
  createdAt   DateTime @default(now())
}

model Progress {
  id                String   @id @default(uuid())
  totalXp           Int      @default(0)
  level             Int      @default(1)
  practiceTime      Int      @default(0)
  conversationCount Int      @default(0)
  wordsMastered     Int      @default(0)
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [clerkId])
}

model KnowledgeDocument {
  id        String           @id @default(uuid())
  title     String
  content   String
  category  String?
  language  String           @default("de")
  createdAt DateTime         @default(now())
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  content    String
  chunkIndex Int
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id])
}
